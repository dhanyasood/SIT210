// Pin numbers
int porch = 2;
int hallway = 3;
int button = 4;

// Store the time when button is pressed
unsigned long startTime;


// Setup the Arduino
void setup() {

  pinMode(porch, OUTPUT);
  pinMode(hallway, OUTPUT);
  pinMode(button, INPUT_PULLUP); //internal pull up resistor

  turnLightsOff();
}


// Main program
void loop() {

  // Check if button is pressed
  if (digitalRead(button) == LOW) {

    turnLightsOn();

    startTime = millis();

    waitForPorchTime();

    turnPorchOff();

    waitForHallwayTime();

    turnHallwayOff();

    waitForButtonRelease();
  }
}


// Turn both lights ON
void turnLightsOn() {

  digitalWrite(porch, HIGH);
  digitalWrite(hallway, HIGH);
}


// Turn both lights OFF
void turnLightsOff() {

  digitalWrite(porch, LOW);
  digitalWrite(hallway, LOW);
}


// Wait until 30 seconds have passed
void waitForPorchTime() {
//currenttime- start time
  while (millis() - startTime < 30000) { //calculates time passed
    // Wait
  }
}


// Turn porch light OFF
void turnPorchOff() {

  digitalWrite(porch, LOW);
}


// Wait until 60 seconds have passed
void waitForHallwayTime() {

  while (millis() - startTime < 60000) {
    // Wait
  }
}


// Turn hallway light OFF
void turnHallwayOff() {

  digitalWrite(hallway, LOW);
}


// Wait for the user to release the button
void waitForButtonRelease() {

  while (digitalRead(button) == LOW) {
    // Wait
  }
}
