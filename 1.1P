// Pin numbers
int porch = 2;
int hallway = 3;
int button = 4;

// Store the time when button is pressed
unsigned long startTime; 

void setup() {

  pinMode(porch, OUTPUT);
  pinMode(hallway, OUTPUT);

  pinMode(button, INPUT_PULLUP); //internal puul up resistor

  // Lights OFF
  digitalWrite(porch, LOW);
  digitalWrite(hallway, LOW);
}

void loop() {

  // Wait for button press
  if (digitalRead(button) == LOW) {

    // Turn both lights ON
    digitalWrite(porch, HIGH);
    digitalWrite(hallway, HIGH);

    // Remember when the lights were turned ON
    startTime = millis(); 

    // Keep lights ON for the required time

    // Porch light: 30 seconds
    //calculates time passed
    while (millis() - startTime < 30000) { //current time - start time
      // Wait
    }

    digitalWrite(porch, LOW);

    // Hallway stays ON for another 30 seconds
    while (millis() - startTime < 60000) {
      // Wait
    }

    digitalWrite(hallway, LOW);

    // Wait until button is released
    while (digitalRead(button) == LOW) {
      // Wait
    }
  }
}
